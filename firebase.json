{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "predeploy": ["node scripts/prepare-hosting.mjs"],
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": "chat"
      }
    ]
  }
}
